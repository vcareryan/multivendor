# ─────────────────────────────────────────────────────────────
# UtanStore environment template. Copy to .env and fill values.
# ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ---- Platform ----
APP_BASE_DOMAIN=utanstore.com
# Reserved host that serves the super-admin dashboard
SUPERADMIN_HOST=admin.utanstore.com
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
# DATABASE_URL uses the app role (RLS-enforced, NOT a superuser / NOT BYPASSRLS)
DATABASE_URL=postgresql://utan_app:app_password@localhost:5432/utanstore?schema=public
# DIRECT_DATABASE_URL used by Prisma Migrate (owner role)
DIRECT_DATABASE_URL=postgresql://utan_owner:owner_password@localhost:5432/utanstore?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth / JWT ----
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_TTL=900          # seconds (15m)
JWT_REFRESH_TTL=2592000     # seconds (30d)
COOKIE_DOMAIN=.utanstore.com

# ---- Encryption (AES-256-GCM master key: 32 bytes, base64 or hex 64 chars) ----
ENCRYPTION_KEY=change_me_64_hex_chars_0000000000000000000000000000000000000000

# ---- Object storage (S3-compatible: MinIO / R2) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=utanstore
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/utanstore
S3_FORCE_PATH_STYLE=true

# ---- Rate limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_BASE_DOMAIN=utanstore.com

# ---- OTP defaults (per-store overrides live encrypted in DB) ----
OTP_TTL_SECONDS=300
OTP_MAX_RETRIES=5
OTP_RESEND_DELAY_SECONDS=30

# ---- Seeding (no credentials are hardcoded in source) ----
# If SUPERADMIN_PASSWORD is omitted, the seed generates a strong random one and
# prints it ONCE. SEED_DEMO=true also creates a demo grocery store.
SUPERADMIN_EMAIL=admin@utanstore.com
SUPERADMIN_PASSWORD=
SEED_DEMO=false
DEMO_OWNER_PASSWORD=

# NOTE: Per-tenant payment/OTP/Google credentials are stored ENCRYPTED in the
# database and configured from the admin dashboard — not here.
