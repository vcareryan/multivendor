{
	# Global options
	email {$ACME_EMAIL}

	# On-demand TLS (real Let's Encrypt) — used ONLY for custom store domains that
	# point directly at this server (not proxied through Cloudflare). Gated by the
	# API so only VERIFIED domains ever get a certificate.
	on_demand_tls {
		ask http://api:4000/api/v1/public/domains/authorize
	}
}

# ─────────────────────────────────────────────────────────────
# Platform hosts (*.{$APP_BASE_DOMAIN}) are served BEHIND Cloudflare.
# Caddy presents an INTERNAL (self-signed) certificate, which Cloudflare accepts
# in SSL/TLS mode "Full". There is no public ACME here, so certificate issuance
# can never fail behind Cloudflare's proxy — every store (and every new store)
# works instantly. Cloudflare provides the real public HTTPS, CDN and WAF.
#
# IMPORTANT: set Cloudflare SSL/TLS mode to "Full" (NOT "Full (strict)" — strict
# would reject the self-signed origin cert).
# ─────────────────────────────────────────────────────────────
api.{$APP_BASE_DOMAIN} {
	tls internal
	reverse_proxy api:4000
}

{$APP_BASE_DOMAIN}, www.{$APP_BASE_DOMAIN} {
	tls internal
	encode zstd gzip
	reverse_proxy web:3000
}

# Store subdomains (<slug>.{$APP_BASE_DOMAIN}) + admin.{$APP_BASE_DOMAIN}
*.{$APP_BASE_DOMAIN} {
	tls internal
	encode zstd gzip
	reverse_proxy web:3000
}

# ─────────────────────────────────────────────────────────────
# Custom store domains (a shop owner's OWN domain, pointed directly at this
# server — not through the platform's Cloudflare). These need a real,
# browser-trusted certificate, issued on demand via Let's Encrypt and gated by
# the ask-endpoint above.
# ─────────────────────────────────────────────────────────────
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy web:3000
}
