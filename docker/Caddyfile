{
	# Global options
	email {$ACME_EMAIL}

	# On-demand TLS: Caddy asks the API before issuing a certificate for an
	# unknown hostname. The API returns 200 only for VERIFIED custom domains
	# and known system subdomains — preventing certificate-issuance abuse.
	on_demand_tls {
		ask http://api:4000/api/v1/public/domains/authorize
	}
}

# ─────────────────────────────────────────────────────────────
# API — api.utanstore.com
# ─────────────────────────────────────────────────────────────
api.{$APP_BASE_DOMAIN} {
	reverse_proxy api:4000
}

# ─────────────────────────────────────────────────────────────
# Platform apex + www + super-admin — served by the web app
# ─────────────────────────────────────────────────────────────
{$APP_BASE_DOMAIN}, www.{$APP_BASE_DOMAIN}, admin.{$APP_BASE_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

# ─────────────────────────────────────────────────────────────
# Everything else — store subdomains (<slug>.utanstore.com) AND custom store
# domains. TLS is issued PER HOSTNAME on demand via the HTTP challenge (no
# DNS-provider/wildcard cert needed), gated by the /public/domains/authorize
# ask-endpoint so only valid stores + verified custom domains get certificates.
# ─────────────────────────────────────────────────────────────
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy web:3000
}
