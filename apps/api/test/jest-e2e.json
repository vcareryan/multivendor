{
  "testEnvironment": "node",
  "rootDir": ".",
  "roots": ["<rootDir>"],
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "moduleFileExtensions": ["ts", "js", "json"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "../tsconfig.json", "isolatedModules": true }]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1"
  },
  "testTimeout": 60000
}
