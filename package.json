{
  "name": "utanstore",
  "version": "0.1.0",
  "private": true,
  "description": "UtanStore — multi-tenant SaaS e-commerce platform (NestJS + Next.js + Prisma)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @utanstore/db generate",
    "db:migrate": "pnpm --filter @utanstore/db migrate",
    "db:deploy": "pnpm --filter @utanstore/db deploy",
    "db:seed": "pnpm --filter @utanstore/db seed",
    "db:studio": "pnpm --filter @utanstore/db studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}
